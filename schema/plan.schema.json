      "required": [
        "id",
        "name",
        "visible",
        "locked",
        "color"
      ],
      "type": "object"
    },
    "LayerId": {
      "type": "string"
    },
    "Obj": {
      "anyOf": [
        {
          "$ref": "#/definitions/Wall"
        },
        {
          "$ref": "#/definitions/Beam"
        },
        {
          "$ref": "#/definitions/Partition"
        },
        {
          "$ref": "#/definitions/Room"
        },
        {
          "$ref": "#/definitions/Opening"
        },
        {
          "$ref": "#/definitions/Furniture"
        },
        {
          "$ref": "#/definitions/Dimension"
        },
        {
          "$ref": "#/definitions/ImageObj"
        },
        {
          "$ref": "#/definitions/Electrical"
        }
      ]
