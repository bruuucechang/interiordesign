        },
        "group": {
          "type": "string"
        },
        "h": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "item": {
          "type": "string"
        },
        "kind": {
          "const": "furniture",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "layer": {
          "$ref": "#/definitions/LayerId"
        },
        "w": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "angle",
        "h",
        "id",
        "item",
        "kind",
        "label",
        "layer",
        "w",
        "x",
        "y"
      ],
      "type": "object"
    },
    "ImageObj": {
      "properties": {
        "group": {
          "type": "string"
        },
        "h": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "image",
          "type": "string"
        },
        "layer": {
          "$ref": "#/definitions/LayerId"
        },
        "opacity": {
          "type": "number"
        },
        "src": {
          "type": "string"
        },
        "w": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "h",
        "id",
        "kind",
        "layer",
        "opacity",
        "src",
        "w",
        "x",
        "y"
      ],
      "type": "object"
    },
    "Layer": {
      "properties": {
        "color": {
          "type": "string"
        },
        "id": {
          "$ref": "#/definitions/LayerId"
        },
        "locked": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        }
