      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Wall": {
      "properties": {
        "a": {
          "$ref": "#/definitions/Vec"
        },
        "b": {
          "$ref": "#/definitions/Vec"
        },
        "bulge": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "finish": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "height": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "wall",
          "type": "string"
        },
        "layer": {
          "$ref": "#/definitions/LayerId"
        },
        "thickness": {
          "type": "number"
        }
      },
      "required": [
        "a",
        "b",
        "id",
        "kind",
        "layer",
        "thickness"
      ],
      "type": "object"
    }
  }
}