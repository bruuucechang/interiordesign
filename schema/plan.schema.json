    "Opening": {
      "properties": {
        "angle": {
          "type": "number"
        },
        "bulge": {
          "type": "number"
        },
        "elevation": {
          "type": "number"
        },
        "group": {
          "type": "string"
        },
        "height": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "door",
            "window"
          ],
          "type": "string"
        },
        "layer": {
          "$ref": "#/definitions/LayerId"
        },
        "style": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "angle",
        "id",
        "kind",
        "layer",
        "width",
        "x",
        "y"
      ],
      "type": "object"
    },
    "Partition": {
      "properties": {
        "a": {
          "$ref": "#/definitions/Vec"
        },
        "b": {
          "$ref": "#/definitions/Vec"
        },
        "group": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "partition",
          "type": "string"
        },
        "layer": {
          "$ref": "#/definitions/LayerId"
        }
      },
      "required": [
        "a",
        "b",
        "id",
        "kind",
        "layer"
      ],
      "type": "object"
    },
    "Project": {
      "properties": {
        "activeFloorId": {
          "type": "string"
        },
        "floors": {
          "items": {
            "$ref": "#/definitions/Floor"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "layers": {
          "items": {
            "$ref": "#/definitions/Layer"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "schemaVersion": {
          "description": "Which revision of this schema the plan was written against. Bumped only by a change that older plans cannot satisfy; migrate.ts holds the step that moves a plan up to it, and the backend can then assume one shape.",
          "type": "number"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "name",
        "layers",
        "floors",
        "activeFloorId"
      ],
      "type": "object"
    },
    "Room": {
      "properties": {
        "auto": {
          "type": "boolean"
        },
        "floor": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "h": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "room",
          "type": "string"
        },
        "layer": {
          "$ref": "#/definitions/LayerId"
        },
        "name": {
          "type": "string"
        },
        "poly": {
