{
  "$ref": "#/definitions/Project",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Beam": {
      "properties": {
        "a": {
          "$ref": "#/definitions/Vec"
        },
        "b": {
          "$ref": "#/definitions/Vec"
        },
        "elevation": {
          "type": "number"
        },
        "group": {
          "type": "string"
        },
        "height": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "beam",
          "type": "string"
        },
        "layer": {
          "$ref": "#/definitions/LayerId"
        },
        "width": {
          "type": "number"
        }
      },
      "required": [
        "a",
        "b",
        "elevation",
        "height",
        "id",
        "kind",
        "layer",
        "width"
      ],
      "type": "object"
    },
    "Dimension": {
      "properties": {
        "a": {
          "$ref": "#/definitions/Vec"
        },
        "b": {
          "$ref": "#/definitions/Vec"
        },
        "group": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "dimension",
          "type": "string"
        },
        "layer": {
          "$ref": "#/definitions/LayerId"
        },
        "offset": {
          "type": "number"
        }
      },
      "required": [
        "a",
        "b",
        "id",
        "kind",
        "layer",
        "offset"
      ],
      "type": "object"
    },
    "Electrical": {
      "properties": {
        "angle": {
          "type": "number"
        },
        "elevation": {
          "description": "Height above the floor (cm). Sockets sit low, switches at handle height.",
          "type": "number"
        },
        "group": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "item": {
          "$ref": "#/definitions/ElectricalId"
        },
        "kind": {
          "const": "electrical",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "layer": {
          "$ref": "#/definitions/LayerId"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "angle",
        "id",
        "item",
        "kind",
        "layer",
        "x",
        "y"
      ],
      "type": "object"
    },
    "ElectricalId": {
      "enum": [
        "socket",
        "socket2",
        "socketWater",
        "tv",
        "network",
        "switch1",
        "switch2",
        "switch3",
        "ceilingLight",
        "downlight",
        "spotlight",
        "pendant",
        "wallLight",
        "exhaust"
      ],
      "type": "string"
    },
    "Floor": {
      "properties": {
        "elevation": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "objects": {
          "items": {
            "$ref": "#/definitions/Obj"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "elevation",
        "height",
        "objects"
      ],
      "type": "object"
    },
    "Furniture": {
      "properties": {
